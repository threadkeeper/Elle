{
  "swagger": "2.0",
  "info": {
    "title": "Elle Private Bridge",
    "description": "Private Elle REST actions authenticated by a trusted delegated bridge actor and a fixed Copilot Studio user object ID.",
    "version": "1.0",
    "contact": {
      "name": "threadkeeper",
      "url": "https://github.com/threadkeeper/Elle"
    }
  },
